    "faqs": [
        {
            "question": "What concepts are under Platinum Hospitality Management?",
            "answer": "Platinum Hospitality Management operates three premier restaurant and café brands: Shakespeare Middle East (Victorian café & patisserie), Otantik Café & Restaurant (Middle Eastern & Mediterranean dining and shisha lounge), and Chinese Connection (contemporary pan-Asian & wok dining).",
            "category": "general",
            "status": "published",
            "sort_order": 1
        },
        {
            "question": "How can I apply for a restaurant franchise with Platinum Hospitality?",
            "answer": "Visit our Franchise page or submit an inquiry via our contact form. Our franchising team provides end-to-end guidance including concept setup, site selection, kitchen architecture, staff training, and ongoing operational support.",
            "category": "franchise",
            "status": "published",
            "sort_order": 2
        },
        {
            "question": "Does Platinum Hospitality Management provide bespoke consulting for third-party venues?",
            "answer": "Yes, we collaborate with property developers, investors, and hotel owners on turnkey F&B management, kitchen efficiency audits, menu engineering, and brand turnaround solutions.",
            "category": "partnership",
            "status": "published",
            "sort_order": 3
        }
    ],
